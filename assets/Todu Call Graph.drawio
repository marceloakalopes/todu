        <UserObject label="&lt;div style=&quot;background-color:#1e1e1e;color:#d4d4d4&quot;&gt;&lt;pre style=&quot;font-family:&#39;JetBrains Mono&#39;,monospace;font-size:9.8pt;&quot;&gt;&lt;div&gt;&lt;pre style=&quot;font-family:&#39;JetBrains Mono&#39;,monospace;font-size:9.8pt;&quot;&gt;&lt;span style=&quot;color:#47a2ed;&quot;&gt;package &lt;/span&gt;app.todu.models&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#47a2ed;&quot;&gt;import &lt;/span&gt;java.time.&lt;span style=&quot;color:#47ccb1;&quot;&gt;LocalDate&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#47ccb1;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#6a9955;&quot;&gt;/**&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#6a9955;&quot;&gt; * Data class to represent a task&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#6a9955;&quot;&gt; *&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#6a9955;&quot;&gt; * &lt;/span&gt;&lt;span style=&quot;color:#569cd5;&quot;&gt;@param &lt;/span&gt;&lt;span style=&quot;color:#8cd7ff;&quot;&gt;[id] &lt;/span&gt;&lt;span style=&quot;color:#6a9955;&quot;&gt;the id of the task&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#6a9955;&quot;&gt; * &lt;/span&gt;&lt;span style=&quot;color:#569cd5;&quot;&gt;@param &lt;/span&gt;&lt;span style=&quot;color:#8cd7ff;&quot;&gt;[done] &lt;/span&gt;&lt;span style=&quot;color:#6a9955;&quot;&gt;if the task is done&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#6a9955;&quot;&gt; * &lt;/span&gt;&lt;span style=&quot;color:#569cd5;&quot;&gt;@param &lt;/span&gt;&lt;span style=&quot;color:#8cd7ff;&quot;&gt;[dueDate] &lt;/span&gt;&lt;span style=&quot;color:#6a9955;&quot;&gt;the due date of the task&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#6a9955;&quot;&gt; * &lt;/span&gt;&lt;span style=&quot;color:#569cd5;&quot;&gt;@param &lt;/span&gt;&lt;span style=&quot;color:#8cd7ff;&quot;&gt;[tags] &lt;/span&gt;&lt;span style=&quot;color:#6a9955;&quot;&gt;the tags of the task&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#6a9955;&quot;&gt; * &lt;/span&gt;&lt;span style=&quot;color:#569cd5;&quot;&gt;@param &lt;/span&gt;&lt;span style=&quot;color:#8cd7ff;&quot;&gt;[description] &lt;/span&gt;&lt;span style=&quot;color:#6a9955;&quot;&gt;the description of the task&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#6a9955;&quot;&gt; *&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#6a9955;&quot;&gt; * &lt;/span&gt;&lt;span style=&quot;color:#569cd5;&quot;&gt;@example &lt;/span&gt;&lt;span style=&quot;color:#6a9955;&quot;&gt;Task(1, false, LocalDate.of(2021, 9, 9), listOf(&quot;mobile&quot;), &quot;update UI&quot;)&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#6a9955;&quot;&gt; */&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;color:#47a2ed;&quot;&gt;data class &lt;/span&gt;&lt;span style=&quot;color:#47ccb1;&quot;&gt;Task&lt;/span&gt;(&lt;br&gt;    &lt;span style=&quot;color:#47a2ed;&quot;&gt;val &lt;/span&gt;&lt;span style=&quot;color:#8cd7ff;&quot;&gt;id&lt;/span&gt;: &lt;span style=&quot;color:#47ccb1;&quot;&gt;Int&lt;/span&gt;,&lt;br&gt;    &lt;span style=&quot;color:#47a2ed;&quot;&gt;val &lt;/span&gt;&lt;span style=&quot;color:#8cd7ff;&quot;&gt;done&lt;/span&gt;: &lt;span style=&quot;color:#47ccb1;&quot;&gt;Boolean&lt;/span&gt;,&lt;br&gt;    &lt;span style=&quot;color:#47a2ed;&quot;&gt;val &lt;/span&gt;&lt;span style=&quot;color:#8cd7ff;&quot;&gt;dueDate&lt;/span&gt;: &lt;span style=&quot;color:#47ccb1;&quot;&gt;LocalDate&lt;/span&gt;,&lt;br&gt;    &lt;span style=&quot;color:#47a2ed;&quot;&gt;val &lt;/span&gt;&lt;span style=&quot;color:#8cd7ff;&quot;&gt;tags&lt;/span&gt;: &lt;span style=&quot;color:#3d8f7f;&quot;&gt;List&lt;/span&gt;&amp;lt;&lt;span style=&quot;color:#47ccb1;&quot;&gt;String&lt;/span&gt;&amp;gt;,&lt;br&gt;    &lt;span style=&quot;color:#47a2ed;&quot;&gt;val &lt;/span&gt;&lt;span style=&quot;color:#8cd7ff;&quot;&gt;description&lt;/span&gt;: &lt;span style=&quot;color:#47ccb1;&quot;&gt;String&lt;br&gt;&lt;/span&gt;)&lt;br&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/pre&gt;&lt;/d